{
  "name": "portfolio-tools",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:csp": "node scripts/check-csp-hash.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.sw.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "deploy": "wrangler deploy",
    "deploy:proxy": "wrangler deploy -c wrangler.proxy.toml"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@supabase/supabase-js": "2.112.4",
    "@types/node": "^26.4.0",
    "@vitest/coverage-v8": "^4.1.11",
    "chart.js": "4.5.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.1"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260820.1": true
  }
}
