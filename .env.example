# =========================================================================
# Portfolio Tools — variables d'environnement
# =========================================================================
# En local : `cp .env.example .env` puis remplir (le .env est gitignore).
# En prod (Cloudflare Worker `fragrant-band-1476`) : chaque cle secrete se
# pose avec  `wrangler secret put <NOM> -c wrangler.proxy.toml`
# Les vars publiques (SUPABASE_*) sont deja dans wrangler.proxy.toml [vars].

# --- Donnees de marche (worker/proxy.js) ----------------------------------

# Finnhub — ratios fondamentaux, calendrier resultats, recommandations
# analystes, transactions d'inities, peers. Plan gratuit (60 req/min,
# actions US uniquement). Cle : https://finnhub.io/dashboard
FINNHUB_API_KEY=

# Financial Modeling Prep — etats financiers 5 ans, ratios historiques,
# key-metrics TTM, estimations analystes, DCF, profil. Plan gratuit
# (250 req/jour). Cle : https://site.financialmodelingprep.com/developer/docs
FMP_API_KEY=

# Tavily — recherche d'actualites pour le flux "news". Plan gratuit
# (~1000 req/mois). Cle : https://app.tavily.com/home
TAVILY_API_KEY=

# --- Resumes IA (cles API des utilisateurs, chiffrees dans KV) -----------

# 32 octets aleatoires en base64, chiffre/dechiffre les cles IA (AES-GCM).
# Generer :  openssl rand -base64 32
AI_ENC_KEY=

# --- Supabase (public, deja dans wrangler.proxy.toml) --------------------
SUPABASE_URL=https://ttphzfvgeufoblkqvdsl.supabase.co
SUPABASE_ANON_KEY=sb_publishable_y3tJvH9sPMyHVW27tEwy2A_Rx-VGXCU
